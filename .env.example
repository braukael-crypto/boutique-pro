# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL / Prisma (server and migration environments only)
DATABASE_URL=YOUR_SUPABASE_TRANSACTION_POOLER_URL
DIRECT_URL=YOUR_SUPABASE_SESSION_POOLER_URL

# SasPay (server only)
# Use sk_test_... for sandbox/testing. Do not configure live keys for local/test payment flows.
SASPAY_SECRET_KEY=sk_test_YOUR_TEST_SECRET_KEY
SASPAY_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SIGNING_SECRET
SASPAY_BASE_URL=https://api.saspay.me/api/v1
