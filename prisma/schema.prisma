generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  MANAGER
  STAFF
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CREDIT
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

model Shop {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  slug           String   @unique
  phone          String?
  whatsapp       String?
  address        String?
  logoUrl        String?
  currency       String   @default("XOF")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships          ShopMembership[]
  products             Product[]
  customers            Customer[]
  sales                Sale[]
  stockMovements       StockMovement[]
  expenses             Expense[]
  suppliers            Supplier[]
  subscription         Subscription?
  subscriptionPayments SubscriptionPayment[]

  @@map("shops")
}

model ShopMembership {
  id        String         @id @default(uuid()) @db.Uuid
  shopId    String         @db.Uuid
  userId    String         @db.Uuid
  role      MembershipRole @default(STAFF)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  shop      Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([userId])
  @@map("shop_memberships")
}

model Product {
  id             String          @id @default(uuid()) @db.Uuid
  shopId         String          @db.Uuid
  legacyId BigInt?
  name           String
  category       String          @default("Autres")
  purchasePrice  Decimal         @db.Decimal(14, 2)
  sellingPrice   Decimal         @db.Decimal(14, 2)
  quantity       Int             @default(0)
  minStock       Int             @default(0)
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@unique([shopId, id])
  @@unique([shopId, legacyId])
  @@index([shopId, name])
  @@index([shopId, archivedAt])
  @@map("products")
}

model Customer {
  id            String          @id @default(uuid()) @db.Uuid
  shopId        String          @db.Uuid
  legacyId BigInt?
  name          String
  phone         String?
  address       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  shop          Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sales         Sale[]
  creditPayments CreditPayment[]

  @@unique([shopId, id])
  @@unique([shopId, legacyId])
  @@index([shopId, name])
  @@index([shopId, phone])
  @@map("customers")
}

model Sale {
  id              String          @id @default(uuid()) @db.Uuid
  shopId          String          @db.Uuid
  legacyId BigInt?
  idempotencyKey  String?
  date            DateTime        @default(now())
  total           Decimal         @db.Decimal(14, 2)
  estimatedProfit Decimal         @default(0) @db.Decimal(14, 2)
  paymentMethod   PaymentMethod
  customerId      String?         @db.Uuid
  customerName    String?
  createdAt       DateTime        @default(now())
  shop            Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer        Customer?       @relation(fields: [shopId, customerId], references: [shopId, id], onDelete: Restrict)
  items           SaleItem[]
  creditPayments  CreditPayment[]

  @@unique([shopId, id])
  @@unique([shopId, legacyId])
  @@unique([shopId, idempotencyKey])
  @@index([shopId, date])
  @@index([shopId, customerId])
  @@map("sales")
}

model SaleItem {
  id              String   @id @default(uuid()) @db.Uuid
  shopId          String   @db.Uuid
  saleId          String   @db.Uuid
  productId       String?  @db.Uuid
  productName     String
  quantity        Int
  purchasePrice   Decimal  @db.Decimal(14, 2)
  sellingPrice    Decimal  @db.Decimal(14, 2)
  subtotal        Decimal  @db.Decimal(14, 2)
  estimatedProfit Decimal  @default(0) @db.Decimal(14, 2)
  sale            Sale     @relation(fields: [shopId, saleId], references: [shopId, id], onDelete: Cascade)
  product         Product? @relation(fields: [shopId, productId], references: [shopId, id], onDelete: Restrict)

  @@index([shopId, saleId])
  @@index([shopId, productId])
  @@map("sale_items")
}

model StockMovement {
  id          String            @id @default(uuid()) @db.Uuid
  shopId      String            @db.Uuid
  legacyId BigInt?
  productId   String?           @db.Uuid
  productName String
  saleId      String?           @db.Uuid
  type        StockMovementType
  quantity    Int
  reason      String
  date        DateTime          @default(now())
  stockBefore Int
  stockAfter  Int
  createdAt   DateTime          @default(now())
  shop        Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product     Product?          @relation(fields: [shopId, productId], references: [shopId, id], onDelete: Restrict)

  @@unique([shopId, id])
  @@unique([shopId, legacyId])
  @@index([shopId, productId, date])
  @@index([shopId, date])
  @@map("stock_movements")
}

model CreditPayment {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @db.Uuid
  legacyId BigInt?
  saleId      String   @db.Uuid
  customerId  String?  @db.Uuid
  amount      Decimal  @db.Decimal(14, 2)
  date        DateTime @default(now())
  note        String?
  createdAt   DateTime @default(now())
  sale        Sale     @relation(fields: [shopId, saleId], references: [shopId, id], onDelete: Restrict)
  customer    Customer? @relation(fields: [shopId, customerId], references: [shopId, id], onDelete: Restrict)

  @@unique([shopId, legacyId])
  @@index([shopId, saleId, date])
  @@index([shopId, customerId])
  @@map("credit_payments")
}

model Expense {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @db.Uuid
  legacyId BigInt?
  label     String
  category  String
  amount    Decimal  @db.Decimal(14, 2)
  date      DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, legacyId])
  @@index([shopId, date])
  @@index([shopId, category])
  @@map("expenses")
}


model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @db.Uuid
  legacyId  BigInt?
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, id])
  @@unique([shopId, legacyId])
  @@index([shopId, name])
  @@index([shopId, phone])
  @@map("suppliers")
}
model ShopApplication {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  shopName    String
  contactName String
  phone       String
  email       String
  address     String?
  plan        String
  status      String    @default("PENDING")
  adminNote   String?
  reviewedAt  DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz

  @@index([status, createdAt(sort: Desc)], map: "shop_applications_status_created_idx")
  @@map("shop_applications")
}

model SubscriptionPlan {
  code          String   @id
  name          String
  monthlyAmount Decimal  @db.Decimal(14, 2)
  currency      String   @default("XOF")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz

  subscriptions        Subscription[]
  subscriptionPayments SubscriptionPayment[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String    @id @default(uuid()) @db.Uuid
  shopId             String    @unique @db.Uuid
  plan               String
  status             String    @default("TRIALING")
  billingInterval    String    @default("MONTHLY")
  currency           String    @default("XOF")
  trialStartedAt     DateTime? @db.Timestamptz
  trialEndsAt        DateTime? @db.Timestamptz
  currentPeriodStart DateTime? @db.Timestamptz
  currentPeriodEnd   DateTime? @db.Timestamptz
  createdAt          DateTime  @default(now()) @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @db.Timestamptz

  shop     Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  planRef  SubscriptionPlan      @relation(fields: [plan], references: [code])
  payments SubscriptionPayment[]

  @@index([status, currentPeriodEnd], map: "subscriptions_status_end_idx")
  @@map("subscriptions")
}

model SubscriptionPayment {
  id                String    @id @default(uuid()) @db.Uuid
  shopId            String    @db.Uuid
  subscriptionId    String    @db.Uuid
  plan              String
  provider          String
  status            String    @default("PENDING")
  amount            Decimal   @db.Decimal(14, 2)
  currency          String    @default("XOF")
  providerReference String?
  providerPaymentId String?
  idempotencyKey    String
  paidAt            DateTime? @db.Timestamptz
  periodStart       DateTime? @db.Timestamptz
  periodEnd         DateTime? @db.Timestamptz
  createdAt         DateTime  @default(now()) @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz

  shop         Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  subscription Subscription     @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  planRef      SubscriptionPlan @relation(fields: [plan], references: [code])
  events       PaymentEvent[]

  @@unique([shopId, idempotencyKey], map: "subscription_payments_shopId_idempotencyKey_key")
  @@index([shopId, createdAt(sort: Desc)], map: "subscription_payments_shop_date_idx")
  @@map("subscription_payments")
}

model PaymentEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String
  paymentId   String?   @db.Uuid
  payload     Json
  processedAt DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz

  payment SubscriptionPayment? @relation(fields: [paymentId], references: [id])

  @@unique([provider, eventId], map: "payment_events_provider_eventId_key")
  @@map("payment_events")
}
